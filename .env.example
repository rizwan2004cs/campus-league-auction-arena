# Copy this file to .env and fill in your own values. Never commit .env.
# Supabase dashboard → Project Settings → API (or Data API) for the URL and anon/publishable key.

# Used by the browser app at build time.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Used by the serverless functions in api/ (set these in Vercel, not here).
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
# GROQ_API_KEY=gsk_...            # AI commentary (console.groq.com); optional, falls back to plain text
# CRON_SECRET=any-long-random-string   # optional, protects /api/cron/keep-alive
